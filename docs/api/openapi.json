{
  "openapi": "3.1.0",
  "info": {
    "title": "Rivana Residence API",
    "version": "1.0.0",
    "description": "Generated from src/contracts/api/v1 by `npm run openapi`. Errors use RFC 9457 problem details (docs/api/error-model.md)."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Report whether the app and its database are answering.",
        "tags": [
          "System"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The app and database are up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "Problem details. Codes: INTERNAL, TRY_AGAIN.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "context": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "additionalProperties": false
      },
      "Money": {
        "type": "object",
        "properties": {
          "amountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "currency": {
            "type": "string",
            "const": "USD"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ],
        "additionalProperties": false,
        "description": "An amount in minor units (cents)."
      },
      "Stay": {
        "type": "object",
        "properties": {
          "checkIn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "checkOut": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "checkIn",
          "checkOut"
        ],
        "additionalProperties": false,
        "description": "Branch-local dates (YYYY-MM-DD)."
      },
      "Occupancy": {
        "type": "object",
        "properties": {
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "children": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "adults",
          "children"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "database": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "staffSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rivana.session_token",
        "description": "Better Auth staff session cookie. Same origin only; unsafe methods also require a same-origin Origin header."
      }
    }
  }
}
