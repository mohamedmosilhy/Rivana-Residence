generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// The TypeScript name is StaffRole; the database enum keeps its original name
// (ADR 018). RECEPTIONIST and MANAGER are branch scoped.
enum AdminRole {
  EDITOR
  ADMIN
  RECEPTIONIST
  MANAGER
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum AccommodationType {
  ROOM
  APARTMENT
}

enum BlockReason {
  MAINTENANCE
  OWNER_USE
  OTHER
}

enum ServiceKind {
  BREAKFAST
  AIRPORT_TRANSFER
}

enum ServicePriceUnit {
  PER_BOOKING
  PER_NIGHT
  PER_PERSON
  PER_PERSON_PER_NIGHT
  PER_VEHICLE // M8-T3b, airport transfer only (Q-82)
}

enum CouponKind {
  PERCENT
  FIXED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageKey {
  HOME
  ABOUT
  CONTACT
}

enum PageSectionType {
  HERO
  RICH_TEXT
  IMAGE_TEXT_SPLIT
  GALLERY
  FEATURE_GRID
  ROOM_GRID
  FACILITY_GRID
  CONTACT_CTA
  STATS
}

enum PageSectionMediaRole {
  BACKGROUND
  PRIMARY
  GALLERY
  DECORATIVE
}

enum EntityMediaRole {
  HERO
  GALLERY
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  DELETED
}

// Whether the residence may publish an image. Staff confirm rights when they
// upload; imported reference assets stay UNCONFIRMED until an administrator
// confirms them, and content using them cannot be published.
enum MediaRightsStatus {
  CONFIRMED
  UNCONFIRMED
}

enum EnquiryStatus {
  NEW
  READ
  ARCHIVED
  DELIVERY_FAILED
}

model User {
  id            String    @id @db.VarChar(32)
  name          String    @db.VarChar(120)
  email         String    @unique @db.VarChar(320)
  emailVerified Boolean   @default(false)
  image         String?   @db.VarChar(2048)
  role          AdminRole @default(EDITOR)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  sessions            Session[]
  accounts            Account[]
  updatedSiteSettings SiteSettings[] @relation("SiteSettingsUpdatedBy")
  updatedPages        Page[]         @relation("PageUpdatedBy")
  updatedRooms        Room[]         @relation("RoomUpdatedBy")
  updatedFacilities   Facility[]     @relation("FacilityUpdatedBy")
  createdMedia        MediaAsset[]   @relation("MediaCreatedBy")
  createdPromotions   Promotion[]    @relation("PromotionCreatedBy")
  updatedPromotions   Promotion[]    @relation("PromotionUpdatedBy")
  updatedBranches     Branch[]       @relation("BranchUpdatedBy")

  updatedServiceOfferings   ServiceOffering[]    @relation("ServiceOfferingUpdatedBy")
  createdCoupons            Coupon[]             @relation("CouponCreatedBy")
  updatedCoupons            Coupon[]             @relation("CouponUpdatedBy")
  updatedCommercialSettings CommercialSettings[] @relation("CommercialSettingsUpdatedBy")

  branchAssignments           StaffBranchAssignment[]
  updatedPhysicalRooms        PhysicalRoom[]          @relation("PhysicalRoomUpdatedBy")
  createdInventoryBlocks      InventoryBlock[]        @relation("InventoryBlockCreatedBy")
  cancelledInventoryBlocks    InventoryBlock[]        @relation("InventoryBlockCancelledBy")
  updatedBaseRates            RoomBaseRate[]          @relation("RoomBaseRateUpdatedBy")
  updatedRatePeriods          RatePeriod[]            @relation("RatePeriodUpdatedBy")
  createdReservations         Reservation[]           @relation("ReservationCreatedBy")
  pmsEnteredReservations      Reservation[]           @relation("ReservationPmsEnteredBy")
  blockedGuests               Guest[]                 @relation("GuestBlockedBy")
  whatsAppSettingsUpdates     WhatsAppSettings[]      @relation("WhatsAppSettingsUpdatedBy")
  verificationSettingsUpdates VerificationSettings[]  @relation("VerificationSettingsUpdatedBy")
  whatsAppTemplateUpdates     WhatsAppTemplate[]      @relation("WhatsAppTemplateUpdatedBy")
  syncCheckpoints             BranchSyncCheckpoint[]

  decidedCancellationRequests CancellationRequest[]
  decidedChangeRequests       ChangeRequest[]
}

// Better Auth 1.7 core tables. Field names follow the library schema; the app
// never writes these rows directly except through the provisioning CLI.
model Session {
  id        String   @id @db.VarChar(32)
  token     String   @unique @db.VarChar(255)
  userId    String   @db.VarChar(32)
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @db.VarChar(32)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(32)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?   @db.VarChar(1024)
  password              String?   @db.VarChar(512)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @db.VarChar(32)
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(2048)
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
}

// Failed sign-in counters keyed by an HMAC of the email or client address, so
// no raw email or IP is stored here.
model LoginThrottle {
  key             String    @id @db.VarChar(80)
  failures        Int
  windowStartedAt DateTime  @db.Timestamptz(3)
  lockedUntil     DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([updatedAt])
}

model SiteSettings {
  id                    String   @id @db.VarChar(32)
  timeZone              String   @default("Africa/Cairo") @db.VarChar(100)
  siteName              String   @db.VarChar(120)
  tagline               String?  @db.VarChar(240)
  phone                 String?  @db.VarChar(40)
  email                 String?  @db.VarChar(320)
  addressLine1          String?  @db.VarChar(180)
  addressLine2          String?  @db.VarChar(180)
  city                  String?  @db.VarChar(100)
  country               String?  @db.VarChar(100)
  latitude              Decimal? @db.Decimal(9, 6)
  longitude             Decimal? @db.Decimal(9, 6)
  mapEmbedUrl           String?  @db.VarChar(2048)
  footerText            String?  @db.VarChar(500)
  defaultSeoTitle       String?  @db.VarChar(70)
  defaultSeoDescription String?  @db.VarChar(170)
  logoMediaId           String?  @db.VarChar(32)
  stickyLogoMediaId     String?  @db.VarChar(32)
  faviconMediaId        String?  @db.VarChar(32)
  defaultOgMediaId      String?  @db.VarChar(32)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  updatedById           String?  @db.VarChar(32)

  logoMedia       MediaAsset?  @relation("SiteLogo", fields: [logoMediaId], references: [id], onDelete: Restrict)
  stickyLogoMedia MediaAsset?  @relation("SiteStickyLogo", fields: [stickyLogoMediaId], references: [id], onDelete: Restrict)
  faviconMedia    MediaAsset?  @relation("SiteFavicon", fields: [faviconMediaId], references: [id], onDelete: Restrict)
  defaultOgMedia  MediaAsset?  @relation("SiteDefaultOg", fields: [defaultOgMediaId], references: [id], onDelete: Restrict)
  updatedBy       User?        @relation("SiteSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  socialLinks     SocialLink[]
}

model SocialLink {
  id             String  @id @db.VarChar(32)
  siteSettingsId String  @db.VarChar(32)
  platform       String  @db.VarChar(40)
  label          String  @db.VarChar(80)
  url            String  @db.VarChar(2048)
  sortOrder      Int
  isVisible      Boolean @default(true)

  siteSettings SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)

  @@unique([siteSettingsId, platform])
  @@unique([siteSettingsId, sortOrder])
}

model Page {
  id             String   @id @db.VarChar(32)
  branchId       String   @db.VarChar(32)
  key            PageKey
  title          String   @db.VarChar(120)
  seoTitle       String?  @db.VarChar(70)
  seoDescription String?  @db.VarChar(170)
  ogMediaId      String?  @db.VarChar(32)
  canonicalPath  String   @db.VarChar(255)
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  updatedById    String?  @db.VarChar(32)

  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ogMedia   MediaAsset?   @relation("PageOgMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)
  updatedBy User?         @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  sections  PageSection[]

  @@unique([branchId, key])
  @@unique([branchId, canonicalPath])
}

model PageSection {
  id        String          @id @db.VarChar(32)
  pageId    String          @db.VarChar(32)
  type      PageSectionType
  heading   String?         @db.VarChar(160)
  eyebrow   String?         @db.VarChar(80)
  payload   Json
  sortOrder Int
  isVisible Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  page  Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  media PageSectionMedia[]

  @@unique([pageId, sortOrder])
  @@index([pageId, isVisible, sortOrder])
}

model PageSectionMedia {
  sectionId   String               @db.VarChar(32)
  mediaId     String               @db.VarChar(32)
  role        PageSectionMediaRole
  sortOrder   Int
  altOverride String?              @db.VarChar(300)

  section PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  media   MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([sectionId, role, sortOrder])
  @@index([mediaId])
}

model Room {
  id                String            @id @db.VarChar(32)
  branchId          String            @db.VarChar(32)
  accommodationType AccommodationType @default(ROOM)
  bedroomCount      Int?              @db.SmallInt
  bathroomCount     Int?              @db.SmallInt
  name              String            @db.VarChar(120)
  slug              String            @unique @db.VarChar(120)
  shortDescription  String            @db.VarChar(300)
  description       Json
  sizeSqm           Decimal?          @db.Decimal(6, 2)
  maxAdults         Int
  maxChildren       Int               @default(0)
  bedSummary        String?           @db.VarChar(160)
  viewSummary       String?           @db.VarChar(160)
  featured          Boolean           @default(false)
  sortOrder         Int
  status            PublicationStatus @default(DRAFT)
  seoTitle          String?           @db.VarChar(70)
  seoDescription    String?           @db.VarChar(170)
  ogMediaId         String?           @db.VarChar(32)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  updatedById       String?           @db.VarChar(32)

  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ogMedia          MediaAsset?       @relation("RoomOgMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)
  updatedBy        User?             @relation("RoomUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  features         RoomFeature[]
  media            RoomMedia[]
  physicalRooms    PhysicalRoom[]
  baseRate         RoomBaseRate?
  ratePeriods      RatePeriod[]
  reservationRooms ReservationRoom[]

  // Composite target for same-branch foreign keys from inventory and
  // reservations (ADR 017).
  @@unique([id, branchId])
  @@index([branchId, status, sortOrder])
  @@index([status, sortOrder])
  @@index([featured, status, sortOrder])
}

model PhysicalRoom {
  id          String   @id @db.VarChar(32)
  branchId    String   @db.VarChar(32)
  roomTypeId  String   @db.VarChar(32)
  label       String   @db.VarChar(40)
  active      Boolean  @default(true)
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?  @db.VarChar(32)

  roomType         Room              @relation(fields: [roomTypeId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict)
  updatedBy        User?             @relation("PhysicalRoomUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  blocks           InventoryBlock[]
  reservationRooms ReservationRoom[]

  @@unique([branchId, label])
  @@unique([id, roomTypeId])
  @@unique([id, branchId])
  @@index([roomTypeId, active])
}

model InventoryBlock {
  id             String      @id @db.VarChar(32)
  branchId       String      @db.VarChar(32)
  physicalRoomId String      @db.VarChar(32)
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  reason         BlockReason
  note           String?     @db.VarChar(500)
  cancelledAt    DateTime?   @db.Timestamptz(3)
  cancelledById  String?     @db.VarChar(32)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  createdById    String      @db.VarChar(32)

  physicalRoom PhysicalRoom @relation(fields: [physicalRoomId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User         @relation("InventoryBlockCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy  User?        @relation("InventoryBlockCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([physicalRoomId, startDate])
  @@index([branchId, startDate])
}

model RoomBaseRate {
  roomTypeId  String   @id @db.VarChar(32)
  amountMinor Int
  currency    String   @default("USD") @db.Char(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?  @db.VarChar(32)

  roomType  Room  @relation(fields: [roomTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User? @relation("RoomBaseRateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
}

model RatePeriod {
  id          String   @id @db.VarChar(32)
  roomTypeId  String   @db.VarChar(32)
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  amountMinor Int
  currency    String   @default("USD") @db.Char(3)
  active      Boolean  @default(true)
  label       String?  @db.VarChar(80)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?  @db.VarChar(32)

  roomType          Room               @relation(fields: [roomTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy         User?              @relation("RatePeriodUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  reservationNights ReservationNight[]

  @@index([roomTypeId, startDate])
}

model RoomFeature {
  id        String  @id @db.VarChar(32)
  roomId    String  @db.VarChar(32)
  label     String  @db.VarChar(120)
  iconKey   String? @db.VarChar(60)
  sortOrder Int

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, sortOrder])
  @@index([roomId])
}

model RoomMedia {
  roomId      String          @db.VarChar(32)
  mediaId     String          @db.VarChar(32)
  role        EntityMediaRole
  sortOrder   Int
  altOverride String?         @db.VarChar(300)

  room  Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([roomId, role, sortOrder])
  @@index([mediaId])
}

model Facility {
  id               String            @id @db.VarChar(32)
  branchId         String            @db.VarChar(32)
  name             String            @db.VarChar(120)
  slug             String            @unique @db.VarChar(120)
  shortDescription String            @db.VarChar(300)
  description      Json
  openingHoursText String?           @db.VarChar(500)
  featured         Boolean           @default(false)
  sortOrder        Int
  status           PublicationStatus @default(DRAFT)
  seoTitle         String?           @db.VarChar(70)
  seoDescription   String?           @db.VarChar(170)
  ogMediaId        String?           @db.VarChar(32)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  updatedById      String?           @db.VarChar(32)

  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ogMedia   MediaAsset?     @relation("FacilityOgMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)
  updatedBy User?           @relation("FacilityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  media     FacilityMedia[]

  @@index([branchId, status, sortOrder])
  @@index([status, sortOrder])
  @@index([featured, status, sortOrder])
}

model FacilityMedia {
  facilityId  String          @db.VarChar(32)
  mediaId     String          @db.VarChar(32)
  role        EntityMediaRole
  sortOrder   Int
  altOverride String?         @db.VarChar(300)

  facility Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([facilityId, role, sortOrder])
  @@index([mediaId])
}

model MediaAsset {
  id               String            @id @db.VarChar(32)
  storageProvider  String            @db.VarChar(40)
  storageContainer String            @db.VarChar(100)
  storageKey       String            @db.VarChar(500)
  publicUrl        String?           @db.VarChar(2048)
  originalFilename String            @db.VarChar(255)
  mimeType         String            @db.VarChar(100)
  bytes            Int
  width            Int?
  height           Int?
  checksum         String?           @unique @db.VarChar(128)
  altText          String            @db.VarChar(300)
  caption          String?           @db.VarChar(500)
  credit           String?           @db.VarChar(300)
  focalX           Decimal?          @db.Decimal(4, 3)
  focalY           Decimal?          @db.Decimal(4, 3)
  status           MediaStatus       @default(PENDING)
  rightsStatus     MediaRightsStatus @default(UNCONFIRMED)
  // Provenance for imported assets, e.g. "reference:design/assets/images/pool-main.jpg".
  sourceReference  String?           @db.VarChar(255)
  // A safe, staff-readable reason when status is FAILED.
  failureReason    String?           @db.VarChar(200)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  createdById      String?           @db.VarChar(32)

  createdBy        User?              @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  siteLogoFor      SiteSettings[]     @relation("SiteLogo")
  siteStickyFor    SiteSettings[]     @relation("SiteStickyLogo")
  siteFaviconFor   SiteSettings[]     @relation("SiteFavicon")
  siteDefaultOgFor SiteSettings[]     @relation("SiteDefaultOg")
  pageOgFor        Page[]             @relation("PageOgMedia")
  roomOgFor        Room[]             @relation("RoomOgMedia")
  facilityOgFor    Facility[]         @relation("FacilityOgMedia")
  pageSectionUsage PageSectionMedia[]
  roomUsage        RoomMedia[]
  facilityUsage    FacilityMedia[]
  branchHeroFor    Branch[]           @relation("BranchHeroMedia")

  @@unique([storageProvider, storageContainer, storageKey])
  @@index([status, createdAt])
  @@index([sourceReference])
}

model Promotion {
  id           String            @id @db.VarChar(32)
  internalName String            @db.VarChar(120)
  headline     String            @db.VarChar(160)
  body         String            @db.VarChar(600)
  code         String            @db.VarChar(32)
  terms        String?           @db.VarChar(1200)
  status       PublicationStatus @default(DRAFT)
  startsAt     DateTime?         @db.Timestamptz(3)
  endsAt       DateTime?         @db.Timestamptz(3)
  priority     Int               @default(0)
  showAsPopup  Boolean           @default(true)
  version      Int               @default(1)
  publishedAt  DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  createdById  String?           @db.VarChar(32)
  updatedById  String?           @db.VarChar(32)

  createdBy User? @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User? @relation("PromotionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([status, showAsPopup, startsAt, endsAt, priority])
  @@index([status, updatedAt])
}

model ContactEnquiry {
  id                String        @id @db.VarChar(32)
  // The branch whose contact page sent it; null for enquiries received
  // before branch sites existed (M4).
  branchId          String?       @db.VarChar(32)
  name              String        @db.VarChar(120)
  email             String        @db.VarChar(320)
  phone             String?       @db.VarChar(40)
  subject           String?       @db.VarChar(160)
  message           String        @db.VarChar(4000)
  status            EnquiryStatus @default(NEW)
  deliveryMessageId String?       @db.VarChar(255)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  readAt            DateTime?     @db.Timestamptz(3)
  archivedAt        DateTime?     @db.Timestamptz(3)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([branchId, createdAt])
}

// A hotel location. Owns its pages, facilities, and accommodation listings
// (ADR 017, ADR 026). Branches are deactivated, never deleted. Slug, time,
// and sync-interval rules are CHECK constraints in the migration.
model Branch {
  id                          String       @id @db.VarChar(32)
  slug                        String       @unique @db.VarChar(80)
  name                        String       @db.VarChar(120)
  summary                     String?      @db.VarChar(300)
  status                      BranchStatus @default(ACTIVE)
  onlineBookingEnabled        Boolean      @default(false)
  onlinePaymentEnabled        Boolean      @default(false)
  timeZone                    String       @default("Africa/Cairo") @db.VarChar(100)
  currency                    String       @default("USD") @db.Char(3)
  phone                       String?      @db.VarChar(40)
  email                       String?      @db.VarChar(320)
  addressLine1                String?      @db.VarChar(180)
  addressLine2                String?      @db.VarChar(180)
  city                        String?      @db.VarChar(100)
  country                     String?      @db.VarChar(100)
  latitude                    Decimal?     @db.Decimal(9, 6)
  longitude                   Decimal?     @db.Decimal(9, 6)
  mapEmbedUrl                 String?      @db.VarChar(2048)
  checkInTime                 String?      @db.VarChar(5)
  checkOutTime                String?      @db.VarChar(5)
  heroMediaId                 String?      @db.VarChar(32)
  syncReminderIntervalMinutes Int          @default(30)
  syncFollowUpMinutes         Int          @default(10)
  sortOrder                   Int
  createdAt                   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime     @updatedAt @db.Timestamptz(3)
  updatedById                 String?      @db.VarChar(32)

  heroMedia        MediaAsset?             @relation("BranchHeroMedia", fields: [heroMediaId], references: [id], onDelete: Restrict)
  updatedBy        User?                   @relation("BranchUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  pages            Page[]
  rooms            Room[]
  facilities       Facility[]
  enquiries        ContactEnquiry[]
  assignments      StaffBranchAssignment[]
  serviceOfferings ServiceOffering[]
  couponBranches   CouponBranch[]
  reservations     Reservation[]
  syncCheckpoints  BranchSyncCheckpoint[]

  @@index([status, sortOrder])
}

// Which branches a Receptionist or Manager may work on (ADR 018). Admins are
// implicitly all-branch and Editors have no branch scope, so neither has rows.
model StaffBranchAssignment {
  userId      String   @db.VarChar(32)
  branchId    String   @db.VarChar(32)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  // Not a foreign key, so the record survives the creator's removal.
  createdById String?  @db.VarChar(32)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
}

// Append-only history of sensitive changes. actorId and branchId are plain
// text, not foreign keys, so history survives user and branch changes. The
// runtime role's UPDATE/DELETE revocation is a Phase 12 deployment task.
model AuditEvent {
  id         String   @id @db.VarChar(32)
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  actorType  String   @db.VarChar(16)
  actorId    String?  @db.VarChar(32)
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(40)
  entityId   String   @db.VarChar(32)
  branchId   String?  @db.VarChar(32)
  reason     String?  @db.VarChar(500)
  changes    Json?

  @@index([entityType, entityId, occurredAt])
  @@index([branchId, occurredAt])
}

// Commercial rules, M7. SQL checks and the case insensitive coupon index
// live in the commercial_rules migration.
model ServiceOffering {
  id              String           @id @db.VarChar(32)
  branchId        String           @db.VarChar(32)
  kind            ServiceKind
  priceUnit       ServicePriceUnit
  priceMinor      Int
  childPriceMinor Int?
  currency        String           @default("USD") @db.Char(3)
  active          Boolean          @default(false)
  description     String?          @db.VarChar(300)
  maxVehicles     Int? // AIRPORT_TRANSFER only, 1–10; null for BREAKFAST (transfer_vehicles checks, Q-82)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  updatedById     String?          @db.VarChar(32)

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User?  @relation("ServiceOfferingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([branchId, kind])
}

model Coupon {
  id                     String     @id @db.VarChar(32)
  code                   String     @db.VarChar(32)
  kind                   CouponKind
  percentBasisPoints     Int?
  amountMinor            Int?
  currency               String     @default("USD") @db.Char(3)
  startsAt               DateTime?  @db.Timestamptz(3)
  endsAt                 DateTime?  @db.Timestamptz(3)
  maxRedemptions         Int?
  maxRedemptionsPerPhone Int?
  allBranches            Boolean    @default(false)
  active                 Boolean    @default(true)
  description            String?    @db.VarChar(300)
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)
  createdById            String?    @db.VarChar(32)
  updatedById            String?    @db.VarChar(32)

  createdBy    User?              @relation("CouponCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy    User?              @relation("CouponUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branches     CouponBranch[]
  reservations Reservation[]
  redemptions  CouponRedemption[]
}

model CouponBranch {
  couponId String @db.VarChar(32)
  branchId String @db.VarChar(32)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([couponId, branchId])
  @@index([branchId])
}

model CommercialSettings {
  id                 String   @id @db.VarChar(32)
  vatRateBasisPoints Int
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  updatedById        String?  @db.VarChar(32)

  updatedBy User? @relation("CommercialSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

enum ReservationStatus {
  AWAITING_PAYMENT
  CONFIRMED
  PAYMENT_FAILED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
}

enum ReservationSource {
  WEBSITE
  STAFF
  EXTERNAL
}

enum PaymentMethod {
  PAY_AT_HOTEL
  ONLINE
}

enum ReservationPaymentStatus {
  NOT_REQUIRED
  AWAITING
  PAID
  REFUND_PENDING
  REFUNDED
  FAILED
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  EXPIRED
  FAILED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum PaymentEventKind {
  TRANSACTION
  REFUND
}

enum PaymentEventOutcome {
  SUCCEEDED
  DECLINED
  SESSION_CLOSED
  REFUND_SUCCEEDED
  REFUND_FAILED
}

enum PaymentEventResult {
  APPLIED
  IGNORED_MISMATCH
  IGNORED_UNKNOWN
  IGNORED_STATE
}

enum CancellationRequestStatus {
  OPEN
  APPROVED
  REJECTED
  REFUND_PENDING
  REFUND_FAILED
  COMPLETED
  CLOSED
}

enum CancellationRequestedBy {
  GUEST
  STAFF
}

enum CancellationClosedReason {
  STAFF_CANCELLED
  NO_SHOW
  CHECKED_IN
}

enum ChangeRequestStatus {
  OPEN
  APPROVED
  REJECTED
  CLOSED
}

enum NightRateSource {
  BASE
  PERIOD
  MANUAL
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  HELD
}

enum OutboxChannel {
  EMAIL
  WHATSAPP
}

enum VerificationPurpose {
  BOOKING
  GUEST_SESSION
}

// How a verification code was delivered (ADR 031). EMAIL proves only the email.
enum VerificationChannel {
  WHATSAPP
  EMAIL
}

enum SyncCheckpointKind {
  STARTED
  COMPLETED
}

// M8 storage foundation. SQL checks, partial uniqueness and exclusion constraints
// live in the reservations migration. Payment flows remain M9.
model Reservation {
  id                    String                   @id @db.VarChar(32)
  reference             String                   @unique @db.VarChar(16)
  branchId              String                   @db.VarChar(32)
  source                ReservationSource
  status                ReservationStatus
  version               Int                      @default(1)
  checkIn               DateTime                 @db.Date
  checkOut              DateTime                 @db.Date
  guestId               String?                  @db.VarChar(32) // → Guest RESTRICT; required for WEBSITE (CHECK)
  guestName             String                   @db.VarChar(120)
  guestEmail            String?                  @db.VarChar(320) // required for WEBSITE (app rule)
  guestPhone            String?                  @db.VarChar(32)
  guestCountry          String?                  @db.VarChar(2)
  specialRequests       String?                  @db.VarChar(1000)
  internalNotes         String?                  @db.VarChar(2000)
  externalReference     String?                  @db.VarChar(80)
  externalChannel       String?                  @db.VarChar(80)
  currency              String                   @default("USD") @db.Char(3)
  accommodationMinor    Int? // price snapshot (ADR 027); null only for unpriced EXTERNAL
  servicesMinor         Int                      @default(0)
  subtotalMinor         Int?
  discountMinor         Int                      @default(0)
  taxableMinor          Int?
  vatRateBasisPoints    Int? // stored rate used (TX-5)
  vatMinor              Int?
  totalMinor            Int? // taxable + vat
  couponId              String?                  @db.VarChar(32) // → Coupon RESTRICT
  couponCode            String?                  @db.VarChar(32) // as entered, normalized
  couponKind            CouponKind?
  couponValue           Int? // basis points or cents
  paymentMethod         PaymentMethod            @default(PAY_AT_HOTEL)
  paymentStatus         ReservationPaymentStatus @default(NOT_REQUIRED)
  holdExpiresAt         DateTime?                @db.Timestamptz(3) // AWAITING_PAYMENT only
  pmsEnteredAt          DateTime?                @db.Timestamptz(3) // WEBSITE only (Q-40)
  pmsEnteredById        String?                  @db.VarChar(32)
  changeSeq             Int                      @default(0) // last ReservationChange.seq (M8-T9)
  pmsUpdatePendingSince DateTime?                @db.Timestamptz(3) // set by a change after hotel-system entry (Q-84)
  privacyNoticeVersion  String?                  @db.VarChar(40)
  verificationChannel   VerificationChannel? // WEBSITE: how the contact was verified; null reads as WHATSAPP (ADR 031)
  verifiedEmail         String?                  @db.VarChar(320) // the email an EMAIL code proved; never changed by contact edits (CHECK)
  manageTokenHash       String?                  @unique @db.VarChar(64)
  manageTokenExpiresAt  DateTime?                @db.Timestamptz(3)
  idempotencyKeyHash    String?                  @db.VarChar(64)
  requestFingerprint    String?                  @db.VarChar(64)
  statusChangedAt       DateTime                 @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  createdById           String?                  @db.VarChar(32) // staff; null for WEBSITE
  branch                Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  guest                 Guest?                   @relation(fields: [guestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  coupon                Coupon?                  @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy             User?                    @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pmsEnteredBy          User?                    @relation("ReservationPmsEnteredBy", fields: [pmsEnteredById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rooms                 ReservationRoom[]
  services              ReservationService[]
  redemption            CouponRedemption?
  notifications         NotificationOutbox[]
  changes               ReservationChange[]
  payments              Payment[]
  cancellationRequests  CancellationRequest[]
  changeRequests        ChangeRequest[]

  @@unique([id, branchId]) // composite-FK target for ReservationRoom
  @@unique([branchId, externalReference])
  @@index([branchId, status, checkIn])
  @@index([branchId, checkIn, checkOut])
  @@index([guestEmail])
  @@index([verifiedEmail]) // per email cap (ADR 031)
  @@index([guestId, checkIn])
  @@index([status, holdExpiresAt]) // hold expiry job
  @@index([branchId, source, pmsEnteredAt])
}

model Payment {
  id                    String         @id @db.VarChar(32) // merchant reference
  reservationId         String         @db.VarChar(32)
  provider              String         @db.VarChar(32)
  providerOrderId       String?        @db.VarChar(80)
  providerTransactionId String?        @unique @db.VarChar(80)
  checkoutUrl           String?        @db.VarChar(2048)
  amountMinor           Int
  currency              String         @db.Char(3)
  status                PaymentStatus  @default(INITIATED)
  expiresAt             DateTime       @db.Timestamptz(3)
  refundAttempt         Int            @default(0)
  refundRequestedAt     DateTime?      @db.Timestamptz(3)
  refundProviderId      String?        @db.VarChar(80)
  refundedAt            DateTime?      @db.Timestamptz(3)
  lastError             String?        @db.VarChar(200)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  reservation           Reservation    @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  events                PaymentEvent[]

  // Positive USD amounts and one INITIATED payment per reservation are enforced in SQL.
  @@index([status, expiresAt])
  @@index([reservationId])
}

model PaymentEvent {
  id              String              @id @db.VarChar(32)
  paymentId       String?             @db.VarChar(32) // null for an unknown payment
  providerEventId String              @unique @db.VarChar(120)
  kind            PaymentEventKind
  outcome         PaymentEventOutcome
  result          PaymentEventResult
  amountMinor     Int?
  currency        String?             @db.Char(3)
  receivedAt      DateTime            @default(now()) @db.Timestamptz(3)
  payment         Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([paymentId])
}

model CancellationRequest {
  id             String                    @id @db.VarChar(32)
  reservationId  String                    @db.VarChar(32)
  requestedBy    CancellationRequestedBy
  status         CancellationRequestStatus @default(OPEN)
  guestReason    String?                   @db.VarChar(500)
  decidedById    String?                   @db.VarChar(32)
  decidedAt      DateTime?                 @db.Timestamptz(3)
  decisionReason String?                   @db.VarChar(500)
  cancelReason   String?                   @db.VarChar(32)
  notifyGuest    Boolean?
  closedReason   CancellationClosedReason?
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)
  reservation    Reservation               @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy      User?                     @relation(fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // One OPEN request per reservation and closed reason consistency are enforced in SQL.
  @@index([status, createdAt])
  @@index([reservationId])
}

model ChangeRequest {
  id                 String                    @id @db.VarChar(32)
  reservationId      String                    @db.VarChar(32)
  reservationVersion Int
  status             ChangeRequestStatus       @default(OPEN)
  requested          Json
  requestedSummary   Json
  oldTotalMinor      Int
  previewTotalMinor  Int
  paidTotalMinor     Int
  lastConflict       String?                   @db.VarChar(60)
  decidedById        String?                   @db.VarChar(32)
  decidedAt          DateTime?                 @db.Timestamptz(3)
  decisionReason     String?                   @db.VarChar(500)
  closedReason       CancellationClosedReason?
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  reservation        Reservation               @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy          User?                     @relation(fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  change             ReservationChange?

  // One OPEN row per reservation and decision consistency are enforced in SQL.
  @@index([status, createdAt])
  @@index([reservationId, createdAt])
}

// Append-only change history (M8-T9). Summaries hold no personal values.
// SQL checks (seq, override all-or-none) live in the reservation_changes migration.
model ReservationChange {
  id                String         @id @db.VarChar(32)
  reservationId     String         @db.VarChar(32)
  branchId          String         @db.VarChar(32)
  seq               Int // 1, 2, … per reservation; matches Reservation.changeSeq after the write
  kind              String         @db.VarChar(24) // STAY or CANCEL (T9); SERVICES arrives with T9b
  actorType         String         @db.VarChar(16)
  actorId           String?        @db.VarChar(32)
  before            Json
  after             Json
  oldTotalMinor     Int?
  newTotalMinor     Int?
  overrideFromMinor Int? // re-quoted total before a staff override
  overrideToMinor   Int? // total the staff member set
  overrideReason    String?        @db.VarChar(500)
  changeRequestId   String?        @unique @db.VarChar(32)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  reservation       Reservation    @relation(fields: [reservationId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict)
  changeRequest     ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([reservationId, seq])
  @@index([branchId, createdAt])
}

model ReservationRoom {
  id                String             @id @db.VarChar(32)
  reservationId     String             @db.VarChar(32) // → Reservation CASCADE
  branchId          String             @db.VarChar(32) // (roomTypeId, branchId) → Room(id, branchId)
  roomTypeId        String             @db.VarChar(32)
  physicalRoomId    String?            @db.VarChar(32) // (physicalRoomId, roomTypeId) → PhysicalRoom(id, roomTypeId)
  checkIn           DateTime           @db.Date // = reservation stay (v1), kept for constraints/queries
  checkOut          DateTime           @db.Date
  adults            Int
  children          Int                @default(0)
  consumesInventory Boolean
  subtotalMinor     Int?
  reservation       Reservation        @relation(fields: [reservationId, branchId], references: [id, branchId], onDelete: Cascade, onUpdate: Restrict)
  roomType          Room               @relation(fields: [roomTypeId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict)
  physicalRoom      PhysicalRoom?      @relation(fields: [physicalRoomId, roomTypeId], references: [id, roomTypeId], onDelete: Restrict, onUpdate: Restrict)
  nights            ReservationNight[]

  @@index([branchId, roomTypeId, consumesInventory, checkIn, checkOut])
}

model ReservationNight {
  reservationRoomId String           @db.VarChar(32) // → ReservationRoom CASCADE
  night             DateTime         @db.Date
  amountMinor       Int?
  rateSource        NightRateSource?
  ratePeriodId      String?          @db.VarChar(32) // historical pointer, SET NULL
  label             String?          @db.VarChar(80)
  room              ReservationRoom  @relation(fields: [reservationRoomId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  ratePeriod        RatePeriod?      @relation(fields: [ratePeriodId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@id([reservationRoomId, night])
}

model ReservationService {
  reservationId          String           @db.VarChar(32) // → Reservation CASCADE
  kind                   ServiceKind
  priceUnit              ServicePriceUnit // snapshot of the unit used
  priceMinor             Int // adult price used
  childPriceMinor        Int? // child price used, null = children not charged
  adults                 Int
  children               Int
  nights                 Int
  adultQuantity          Int
  childQuantity          Int
  amountMinor            Int
  occupancyEffectiveFrom DateTime?        @db.Date
  vehicles               Int? // cars for AIRPORT_TRANSFER (1–10, every unit); null for BREAKFAST (Q-82)
  details                String?          @db.VarChar(300) // e.g. flight number (Q-56), plain text
  reservation            Reservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([reservationId, kind])
}

model Guest {
  id                      String        @id @db.VarChar(32)
  phone                   String        @unique @db.VarChar(20) // normalized E.164
  name                    String        @db.VarChar(120) // latest used
  email                   String?       @db.VarChar(320) // latest used
  phoneVerifiedAt         DateTime?     @db.Timestamptz(3) // null for staff-entered profiles
  emailVerifiedAt         DateTime?     @db.Timestamptz(3) // email of the profile proven by an email code (ADR 031)
  marketingOptInAt        DateTime?     @db.Timestamptz(3) // Q-58
  marketingConsentVersion String?       @db.VarChar(40)
  marketingOptOutAt       DateTime?     @db.Timestamptz(3)
  blockedAt               DateTime?     @db.Timestamptz(3)
  blockedById             String?       @db.VarChar(32)
  blockReason             String?       @db.VarChar(500)
  createdAt               DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @db.Timestamptz(3)
  reservations            Reservation[]
  blockedBy               User?         @relation("GuestBlockedBy", fields: [blockedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([blockedAt])
  @@index([name])
}

model PhoneVerification {
  id             String              @id @db.VarChar(32)
  phone          String              @db.VarChar(20)
  purpose        VerificationPurpose
  channel        VerificationChannel @default(WHATSAPP)
  email          String?             @db.VarChar(320) // normalized; EMAIL channel only (CHECK)
  codeHash       String              @db.VarChar(64)
  attempts       Int                 @default(0)
  expiresAt      DateTime            @db.Timestamptz(3) // created + 10 minutes
  verifiedAt     DateTime?           @db.Timestamptz(3)
  tokenHash      String?             @unique @db.VarChar(64) // verification token / guest session (30 minutes)
  tokenExpiresAt DateTime?           @db.Timestamptz(3)
  consumedAt     DateTime?           @db.Timestamptz(3) // BOOKING token used by a reservation
  clientKey      String              @db.VarChar(80) // HMAC of the client address, for limits
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([email, createdAt])
  @@index([clientKey, createdAt])
}

model CouponRedemption {
  couponId      String      @db.VarChar(32) // → Coupon RESTRICT
  reservationId String      @id @db.VarChar(32) // one coupon per reservation
  phone         String?     @db.VarChar(20)
  releasedAt    DateTime?   @db.Timestamptz(3) // payment failed / cancelled (CP-2)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  coupon        Coupon      @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([couponId, releasedAt])
  @@index([couponId, phone, releasedAt])
}

model WhatsAppSettings {
  id                    String    @id @db.VarChar(32)
  businessPhoneNumber   String?   @db.VarChar(20) // E.164; empty placeholder until the client supplies it
  providerPhoneNumberId String?   @db.VarChar(64) // e.g. Meta Cloud API phone-number id; the access token is a server secret, not stored here
  lastTestAt            DateTime? @db.Timestamptz(3)
  lastTestOk            Boolean?
  lastTestError         String?   @db.VarChar(200)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  updatedById           String?   @db.VarChar(32)
  updatedBy             User?     @relation("WhatsAppSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// The Admin's switch for verification codes by email (ADR 031, Q-99). One
// row ("default"), created by the verification_channels migration, off.
model VerificationSettings {
  id           String   @id @db.VarChar(32)
  emailEnabled Boolean  @default(false)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  updatedById  String?  @db.VarChar(32)
  updatedBy    User?    @relation("VerificationSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model WhatsAppTemplate {
  id           String   @id @db.VarChar(32)
  purpose      String   @db.VarChar(40) // VERIFICATION_CODE, BOOKING_CONFIRMED, PAYMENT_NOT_COMPLETED, CANCELLATION_RECEIVED, CANCELLATION_APPROVED, CANCELLATION_REJECTED, REFUND_COMPLETED, CANCELLED_BY_HOTEL, MANAGE_LINK, FEEDBACK_REQUEST, MARKETING, TEST
  language     String   @db.VarChar(10) // e.g. en, ar
  providerName String   @db.VarChar(120) // template name exactly as approved in Meta
  category     String   @db.VarChar(20) // AUTHENTICATION, UTILITY, MARKETING
  variables    Json // ordered list of allowlisted field keys, e.g. ["guestFirstName","reference","checkIn"]
  previewText  String   @db.VarChar(1024) // staff-facing preview, not sent
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  updatedById  String?  @db.VarChar(32)
  // unique active template per (purpose, language) except MARKETING (several allowed): partial unique index in SQL
  updatedBy    User?    @relation("WhatsAppTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model NotificationOutbox {
  id            String        @id @db.VarChar(32)
  channel       OutboxChannel
  kind          String        @db.VarChar(60) // reservation.confirmed, payment.failed, cancellation.approved, feedback.request, marketing.broadcast, …
  reservationId String?       @db.VarChar(32)
  recipient     String        @db.VarChar(320) // email address or E.164 phone
  payload       Json // template data, no secrets except manage URL
  status        OutboxStatus  @default(PENDING)
  attempts      Int           @default(0)
  lastError     String?       @db.VarChar(200)
  availableAt   DateTime      @db.Timestamptz(3)
  sentAt        DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  reservation   Reservation?  @relation(fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, availableAt])
}

model BranchSyncCheckpoint {
  id           String             @id @db.VarChar(32)
  branchId     String             @db.VarChar(32)
  kind         SyncCheckpointKind
  recordedAt   DateTime           @default(now()) @db.Timestamptz(3)
  recordedById String             @db.VarChar(32)
  note         String?            @db.VarChar(500)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recordedBy   User               @relation(fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([branchId, recordedAt])
}
