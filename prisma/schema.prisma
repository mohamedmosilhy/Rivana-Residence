generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// The TypeScript name is StaffRole; the database enum keeps its original name
// (ADR 018). RECEPTIONIST and MANAGER are branch scoped.
enum AdminRole {
  EDITOR
  ADMIN
  RECEPTIONIST
  MANAGER
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum AccommodationType {
  ROOM
  APARTMENT
}

enum BlockReason {
  MAINTENANCE
  OWNER_USE
  OTHER
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageKey {
  HOME
  ABOUT
  CONTACT
}

enum PageSectionType {
  HERO
  RICH_TEXT
  IMAGE_TEXT_SPLIT
  GALLERY
  FEATURE_GRID
  ROOM_GRID
  FACILITY_GRID
  CONTACT_CTA
  STATS
}

enum PageSectionMediaRole {
  BACKGROUND
  PRIMARY
  GALLERY
  DECORATIVE
}

enum EntityMediaRole {
  HERO
  GALLERY
}

enum MediaStatus {
  PENDING
  READY
  FAILED
  DELETED
}

// Whether the residence may publish an image. Staff confirm rights when they
// upload; imported reference assets stay UNCONFIRMED until an administrator
// confirms them, and content using them cannot be published.
enum MediaRightsStatus {
  CONFIRMED
  UNCONFIRMED
}

enum EnquiryStatus {
  NEW
  READ
  ARCHIVED
  DELIVERY_FAILED
}

model User {
  id            String    @id @db.VarChar(32)
  name          String    @db.VarChar(120)
  email         String    @unique @db.VarChar(320)
  emailVerified Boolean   @default(false)
  image         String?   @db.VarChar(2048)
  role          AdminRole @default(EDITOR)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  sessions            Session[]
  accounts            Account[]
  updatedSiteSettings SiteSettings[] @relation("SiteSettingsUpdatedBy")
  updatedPages        Page[]         @relation("PageUpdatedBy")
  updatedRooms        Room[]         @relation("RoomUpdatedBy")
  updatedFacilities   Facility[]     @relation("FacilityUpdatedBy")
  createdMedia        MediaAsset[]   @relation("MediaCreatedBy")
  createdPromotions   Promotion[]    @relation("PromotionCreatedBy")
  updatedPromotions   Promotion[]    @relation("PromotionUpdatedBy")
  updatedBranches     Branch[]       @relation("BranchUpdatedBy")

  branchAssignments        StaffBranchAssignment[]
  updatedPhysicalRooms     PhysicalRoom[]          @relation("PhysicalRoomUpdatedBy")
  createdInventoryBlocks   InventoryBlock[]        @relation("InventoryBlockCreatedBy")
  cancelledInventoryBlocks InventoryBlock[]        @relation("InventoryBlockCancelledBy")
  updatedBaseRates         RoomBaseRate[]          @relation("RoomBaseRateUpdatedBy")
  updatedRatePeriods       RatePeriod[]            @relation("RatePeriodUpdatedBy")
}

// Better Auth 1.7 core tables. Field names follow the library schema; the app
// never writes these rows directly except through the provisioning CLI.
model Session {
  id        String   @id @db.VarChar(32)
  token     String   @unique @db.VarChar(255)
  userId    String   @db.VarChar(32)
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @db.VarChar(32)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(32)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?   @db.VarChar(1024)
  password              String?   @db.VarChar(512)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @db.VarChar(32)
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(2048)
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
}

// Failed sign-in counters keyed by an HMAC of the email or client address, so
// no raw email or IP is stored here.
model LoginThrottle {
  key             String    @id @db.VarChar(80)
  failures        Int
  windowStartedAt DateTime  @db.Timestamptz(3)
  lockedUntil     DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([updatedAt])
}

model SiteSettings {
  id                    String   @id @db.VarChar(32)
  timeZone              String   @default("Africa/Cairo") @db.VarChar(100)
  siteName              String   @db.VarChar(120)
  tagline               String?  @db.VarChar(240)
  phone                 String?  @db.VarChar(40)
  email                 String?  @db.VarChar(320)
  addressLine1          String?  @db.VarChar(180)
  addressLine2          String?  @db.VarChar(180)
  city                  String?  @db.VarChar(100)
  country               String?  @db.VarChar(100)
  latitude              Decimal? @db.Decimal(9, 6)
  longitude             Decimal? @db.Decimal(9, 6)
  mapEmbedUrl           String?  @db.VarChar(2048)
  footerText            String?  @db.VarChar(500)
  defaultSeoTitle       String?  @db.VarChar(70)
  defaultSeoDescription String?  @db.VarChar(170)
  logoMediaId           String?  @db.VarChar(32)
  stickyLogoMediaId     String?  @db.VarChar(32)
  faviconMediaId        String?  @db.VarChar(32)
  defaultOgMediaId      String?  @db.VarChar(32)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  updatedById           String?  @db.VarChar(32)

  logoMedia       MediaAsset?  @relation("SiteLogo", fields: [logoMediaId], references: [id], onDelete: Restrict)
  stickyLogoMedia MediaAsset?  @relation("SiteStickyLogo", fields: [stickyLogoMediaId], references: [id], onDelete: Restrict)
  faviconMedia    MediaAsset?  @relation("SiteFavicon", fields: [faviconMediaId], references: [id], onDelete: Restrict)
  defaultOgMedia  MediaAsset?  @relation("SiteDefaultOg", fields: [defaultOgMediaId], references: [id], onDelete: Restrict)
  updatedBy       User?        @relation("SiteSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  socialLinks     SocialLink[]
}

model SocialLink {
  id             String  @id @db.VarChar(32)
  siteSettingsId String  @db.VarChar(32)
  platform       String  @db.VarChar(40)
  label          String  @db.VarChar(80)
  url            String  @db.VarChar(2048)
  sortOrder      Int
  isVisible      Boolean @default(true)

  siteSettings SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)

  @@unique([siteSettingsId, platform])
  @@unique([siteSettingsId, sortOrder])
}

model Page {
  id             String   @id @db.VarChar(32)
  branchId       String   @db.VarChar(32)
  key            PageKey
  title          String   @db.VarChar(120)
  seoTitle       String?  @db.VarChar(70)
  seoDescription String?  @db.VarChar(170)
  ogMediaId      String?  @db.VarChar(32)
  canonicalPath  String   @db.VarChar(255)
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  updatedById    String?  @db.VarChar(32)

  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ogMedia   MediaAsset?   @relation("PageOgMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)
  updatedBy User?         @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  sections  PageSection[]

  @@unique([branchId, key])
  @@unique([branchId, canonicalPath])
}

model PageSection {
  id        String          @id @db.VarChar(32)
  pageId    String          @db.VarChar(32)
  type      PageSectionType
  heading   String?         @db.VarChar(160)
  eyebrow   String?         @db.VarChar(80)
  payload   Json
  sortOrder Int
  isVisible Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)

  page  Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  media PageSectionMedia[]

  @@unique([pageId, sortOrder])
  @@index([pageId, isVisible, sortOrder])
}

model PageSectionMedia {
  sectionId   String               @db.VarChar(32)
  mediaId     String               @db.VarChar(32)
  role        PageSectionMediaRole
  sortOrder   Int
  altOverride String?              @db.VarChar(300)

  section PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  media   MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([sectionId, role, sortOrder])
  @@index([mediaId])
}

model Room {
  id                String            @id @db.VarChar(32)
  branchId          String            @db.VarChar(32)
  accommodationType AccommodationType @default(ROOM)
  bedroomCount      Int?              @db.SmallInt
  bathroomCount     Int?              @db.SmallInt
  name              String            @db.VarChar(120)
  slug              String            @unique @db.VarChar(120)
  shortDescription  String            @db.VarChar(300)
  description       Json
  sizeSqm           Decimal?          @db.Decimal(6, 2)
  maxAdults         Int
  maxChildren       Int               @default(0)
  bedSummary        String?           @db.VarChar(160)
  viewSummary       String?           @db.VarChar(160)
  featured          Boolean           @default(false)
  sortOrder         Int
  status            PublicationStatus @default(DRAFT)
  seoTitle          String?           @db.VarChar(70)
  seoDescription    String?           @db.VarChar(170)
  ogMediaId         String?           @db.VarChar(32)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  updatedById       String?           @db.VarChar(32)

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ogMedia       MediaAsset?    @relation("RoomOgMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)
  updatedBy     User?          @relation("RoomUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  features      RoomFeature[]
  media         RoomMedia[]
  physicalRooms PhysicalRoom[]
  baseRate      RoomBaseRate?
  ratePeriods   RatePeriod[]

  // Composite target for same-branch foreign keys from inventory and
  // reservations (ADR 017).
  @@unique([id, branchId])
  @@index([branchId, status, sortOrder])
  @@index([status, sortOrder])
  @@index([featured, status, sortOrder])
}

model PhysicalRoom {
  id          String   @id @db.VarChar(32)
  branchId    String   @db.VarChar(32)
  roomTypeId  String   @db.VarChar(32)
  label       String   @db.VarChar(40)
  active      Boolean  @default(true)
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?  @db.VarChar(32)

  roomType  Room             @relation(fields: [roomTypeId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User?            @relation("PhysicalRoomUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  blocks    InventoryBlock[]

  @@unique([branchId, label])
  @@unique([id, roomTypeId])
  @@unique([id, branchId])
  @@index([roomTypeId, active])
}

model InventoryBlock {
  id             String      @id @db.VarChar(32)
  branchId       String      @db.VarChar(32)
  physicalRoomId String      @db.VarChar(32)
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  reason         BlockReason
  note           String?     @db.VarChar(500)
  cancelledAt    DateTime?   @db.Timestamptz(3)
  cancelledById  String?     @db.VarChar(32)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  createdById    String      @db.VarChar(32)

  physicalRoom PhysicalRoom @relation(fields: [physicalRoomId, branchId], references: [id, branchId], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User         @relation("InventoryBlockCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy  User?        @relation("InventoryBlockCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([physicalRoomId, startDate])
  @@index([branchId, startDate])
}

model RoomBaseRate {
  roomTypeId  String   @id @db.VarChar(32)
  amountMinor Int
  currency    String   @default("USD") @db.Char(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?  @db.VarChar(32)

  roomType  Room  @relation(fields: [roomTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User? @relation("RoomBaseRateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
}

model RatePeriod {
  id          String   @id @db.VarChar(32)
  roomTypeId  String   @db.VarChar(32)
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  amountMinor Int
  currency    String   @default("USD") @db.Char(3)
  active      Boolean  @default(true)
  label       String?  @db.VarChar(80)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?  @db.VarChar(32)

  roomType  Room  @relation(fields: [roomTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User? @relation("RatePeriodUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([roomTypeId, startDate])
}

model RoomFeature {
  id        String  @id @db.VarChar(32)
  roomId    String  @db.VarChar(32)
  label     String  @db.VarChar(120)
  iconKey   String? @db.VarChar(60)
  sortOrder Int

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, sortOrder])
  @@index([roomId])
}

model RoomMedia {
  roomId      String          @db.VarChar(32)
  mediaId     String          @db.VarChar(32)
  role        EntityMediaRole
  sortOrder   Int
  altOverride String?         @db.VarChar(300)

  room  Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([roomId, role, sortOrder])
  @@index([mediaId])
}

model Facility {
  id               String            @id @db.VarChar(32)
  branchId         String            @db.VarChar(32)
  name             String            @db.VarChar(120)
  slug             String            @unique @db.VarChar(120)
  shortDescription String            @db.VarChar(300)
  description      Json
  openingHoursText String?           @db.VarChar(500)
  featured         Boolean           @default(false)
  sortOrder        Int
  status           PublicationStatus @default(DRAFT)
  seoTitle         String?           @db.VarChar(70)
  seoDescription   String?           @db.VarChar(170)
  ogMediaId        String?           @db.VarChar(32)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  updatedById      String?           @db.VarChar(32)

  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ogMedia   MediaAsset?     @relation("FacilityOgMedia", fields: [ogMediaId], references: [id], onDelete: Restrict)
  updatedBy User?           @relation("FacilityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  media     FacilityMedia[]

  @@index([branchId, status, sortOrder])
  @@index([status, sortOrder])
  @@index([featured, status, sortOrder])
}

model FacilityMedia {
  facilityId  String          @db.VarChar(32)
  mediaId     String          @db.VarChar(32)
  role        EntityMediaRole
  sortOrder   Int
  altOverride String?         @db.VarChar(300)

  facility Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([facilityId, role, sortOrder])
  @@index([mediaId])
}

model MediaAsset {
  id               String            @id @db.VarChar(32)
  storageProvider  String            @db.VarChar(40)
  storageContainer String            @db.VarChar(100)
  storageKey       String            @db.VarChar(500)
  publicUrl        String?           @db.VarChar(2048)
  originalFilename String            @db.VarChar(255)
  mimeType         String            @db.VarChar(100)
  bytes            Int
  width            Int?
  height           Int?
  checksum         String?           @unique @db.VarChar(128)
  altText          String            @db.VarChar(300)
  caption          String?           @db.VarChar(500)
  credit           String?           @db.VarChar(300)
  focalX           Decimal?          @db.Decimal(4, 3)
  focalY           Decimal?          @db.Decimal(4, 3)
  status           MediaStatus       @default(PENDING)
  rightsStatus     MediaRightsStatus @default(UNCONFIRMED)
  // Provenance for imported assets, e.g. "reference:design/assets/images/pool-main.jpg".
  sourceReference  String?           @db.VarChar(255)
  // A safe, staff-readable reason when status is FAILED.
  failureReason    String?           @db.VarChar(200)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  createdById      String?           @db.VarChar(32)

  createdBy        User?              @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  siteLogoFor      SiteSettings[]     @relation("SiteLogo")
  siteStickyFor    SiteSettings[]     @relation("SiteStickyLogo")
  siteFaviconFor   SiteSettings[]     @relation("SiteFavicon")
  siteDefaultOgFor SiteSettings[]     @relation("SiteDefaultOg")
  pageOgFor        Page[]             @relation("PageOgMedia")
  roomOgFor        Room[]             @relation("RoomOgMedia")
  facilityOgFor    Facility[]         @relation("FacilityOgMedia")
  pageSectionUsage PageSectionMedia[]
  roomUsage        RoomMedia[]
  facilityUsage    FacilityMedia[]
  branchHeroFor    Branch[]           @relation("BranchHeroMedia")

  @@unique([storageProvider, storageContainer, storageKey])
  @@index([status, createdAt])
  @@index([sourceReference])
}

model Promotion {
  id           String            @id @db.VarChar(32)
  internalName String            @db.VarChar(120)
  headline     String            @db.VarChar(160)
  body         String            @db.VarChar(600)
  code         String            @db.VarChar(32)
  terms        String?           @db.VarChar(1200)
  status       PublicationStatus @default(DRAFT)
  startsAt     DateTime?         @db.Timestamptz(3)
  endsAt       DateTime?         @db.Timestamptz(3)
  priority     Int               @default(0)
  showAsPopup  Boolean           @default(true)
  version      Int               @default(1)
  publishedAt  DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  createdById  String?           @db.VarChar(32)
  updatedById  String?           @db.VarChar(32)

  createdBy User? @relation("PromotionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User? @relation("PromotionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([status, showAsPopup, startsAt, endsAt, priority])
  @@index([status, updatedAt])
}

model ContactEnquiry {
  id                String        @id @db.VarChar(32)
  // The branch whose contact page sent it; null for enquiries received
  // before branch sites existed (M4).
  branchId          String?       @db.VarChar(32)
  name              String        @db.VarChar(120)
  email             String        @db.VarChar(320)
  phone             String?       @db.VarChar(40)
  subject           String?       @db.VarChar(160)
  message           String        @db.VarChar(4000)
  status            EnquiryStatus @default(NEW)
  deliveryMessageId String?       @db.VarChar(255)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  readAt            DateTime?     @db.Timestamptz(3)
  archivedAt        DateTime?     @db.Timestamptz(3)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([branchId, createdAt])
}

// A hotel location. Owns its pages, facilities, and accommodation listings
// (ADR 017, ADR 026). Branches are deactivated, never deleted. Slug, time,
// and sync-interval rules are CHECK constraints in the migration.
model Branch {
  id                          String       @id @db.VarChar(32)
  slug                        String       @unique @db.VarChar(80)
  name                        String       @db.VarChar(120)
  summary                     String?      @db.VarChar(300)
  status                      BranchStatus @default(ACTIVE)
  onlineBookingEnabled        Boolean      @default(false)
  timeZone                    String       @default("Africa/Cairo") @db.VarChar(100)
  currency                    String       @default("USD") @db.Char(3)
  phone                       String?      @db.VarChar(40)
  email                       String?      @db.VarChar(320)
  addressLine1                String?      @db.VarChar(180)
  addressLine2                String?      @db.VarChar(180)
  city                        String?      @db.VarChar(100)
  country                     String?      @db.VarChar(100)
  latitude                    Decimal?     @db.Decimal(9, 6)
  longitude                   Decimal?     @db.Decimal(9, 6)
  mapEmbedUrl                 String?      @db.VarChar(2048)
  checkInTime                 String?      @db.VarChar(5)
  checkOutTime                String?      @db.VarChar(5)
  heroMediaId                 String?      @db.VarChar(32)
  syncReminderIntervalMinutes Int          @default(30)
  syncFollowUpMinutes         Int          @default(10)
  sortOrder                   Int
  createdAt                   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime     @updatedAt @db.Timestamptz(3)
  updatedById                 String?      @db.VarChar(32)

  heroMedia   MediaAsset?             @relation("BranchHeroMedia", fields: [heroMediaId], references: [id], onDelete: Restrict)
  updatedBy   User?                   @relation("BranchUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  pages       Page[]
  rooms       Room[]
  facilities  Facility[]
  enquiries   ContactEnquiry[]
  assignments StaffBranchAssignment[]

  @@index([status, sortOrder])
}

// Which branches a Receptionist or Manager may work on (ADR 018). Admins are
// implicitly all-branch and Editors have no branch scope, so neither has rows.
model StaffBranchAssignment {
  userId      String   @db.VarChar(32)
  branchId    String   @db.VarChar(32)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  // Not a foreign key, so the record survives the creator's removal.
  createdById String?  @db.VarChar(32)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
}

// Append-only history of sensitive changes. actorId and branchId are plain
// text, not foreign keys, so history survives user and branch changes. The
// runtime role's UPDATE/DELETE revocation is a Phase 12 deployment task.
model AuditEvent {
  id         String   @id @db.VarChar(32)
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  actorType  String   @db.VarChar(16)
  actorId    String?  @db.VarChar(32)
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(40)
  entityId   String   @db.VarChar(32)
  branchId   String?  @db.VarChar(32)
  reason     String?  @db.VarChar(500)
  changes    Json?

  @@index([entityType, entityId, occurredAt])
  @@index([branchId, occurredAt])
}
