# Public canonical URL for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only values. Production must use an absolute persistent directory
# outside the application release tree.
APP_URL=http://localhost:3000
MEDIA_STORAGE_ROOT=/absolute/path/to/rivana-media

# Runtime PostgreSQL connection. Use a pooled URL if the production provider
# supplies one. Prisma CLI commands prefer DIRECT_DATABASE_URL when present.
DATABASE_URL=postgresql://rivana:change-me@127.0.0.1:5432/rivana
DIRECT_DATABASE_URL=postgresql://rivana:change-me@127.0.0.1:5432/rivana

# Disposable database for `npm run test:integration`. It is dropped and
# recreated on every run, so the database name must end in `_test`.
TEST_DATABASE_URL=postgresql://rivana:change-me@127.0.0.1:5432/rivana_test

# Admin authentication. Generate with `openssl rand -base64 48`. Rotating it
# invalidates every session.
BETTER_AUTH_SECRET=
# Set to true only when a trusted reverse proxy (Hosting.com Apache/Passenger)
# sets X-Forwarded-For; it enables per-client sign-in throttling.
AUTH_TRUST_PROXY_HEADERS=false

# Staff accounts are created with `npm run staff -- create`; there is no
# environment-provided default administrator.

# Contact enquiry delivery: none (admin inbox only), outbox (development:
# writes each message to CONTACT_OUTBOX_DIR), or smtp (production email).
CONTACT_DELIVERY=none
# CONTACT_OUTBOX_DIR=/absolute/path/to/rivana-outbox
# CONTACT_TO=reservations@example.com
# CONTACT_FROM=website@example.com
# SMTP_HOST=mail.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=website@example.com
# SMTP_PASSWORD=change-me
