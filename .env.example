# Canonical public URL and trusted authentication origin. Production must use
# the final HTTPS host. The media root must be an absolute persistent directory
# outside the application release tree.
APP_URL=http://localhost:3000
MEDIA_STORAGE_ROOT=/absolute/path/to/rivana-media

# Runtime PostgreSQL connection. Use a pooled URL if the production provider
# supplies one. Prisma CLI commands prefer DIRECT_DATABASE_URL when present.
DATABASE_URL=postgresql://rivana:change-me@127.0.0.1:5432/rivana
DIRECT_DATABASE_URL=postgresql://rivana:change-me@127.0.0.1:5432/rivana

# Disposable database for `npm run test:integration`. It is dropped and
# recreated on every run, so the database name must end in `_test`.
TEST_DATABASE_URL=postgresql://rivana:change-me@127.0.0.1:5432/rivana_test

# Admin authentication. Generate with `openssl rand -base64 48`. Rotating it
# invalidates every session.
BETTER_AUTH_SECRET=
# Set to true only when a trusted reverse proxy (Nginx on the Hostinger VPS)
# sets X-Forwarded-For; it enables per-client sign-in throttling.
AUTH_TRUST_PROXY_HEADERS=false

# Staff accounts are created with `npm run staff -- create`; there is no
# default administrator password. `npm run db:seed` creates the first
# administrator only when SEED_ADMIN_PASSWORD is set to a strong password
# (staff password policy). Use it for that one run, then remove it; do not
# keep it in a server .env.
# SEED_ADMIN_PASSWORD=

# Contact enquiry delivery: none (admin inbox only), outbox (development:
# writes each message to CONTACT_OUTBOX_DIR), or smtp (production email).
CONTACT_DELIVERY=none
# CONTACT_OUTBOX_DIR=/absolute/path/to/rivana-outbox
# CONTACT_TO=reservations@example.com
# CONTACT_FROM=website@example.com
# SMTP_HOST=mail.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=website@example.com
# SMTP_PASSWORD=change-me

# Reservation email defaults to fake in development and test, and smtp in
# production. Set smtp explicitly to use the SMTP settings above locally.
# Run the production reservation cron jobs with NODE_ENV=production, too.
# EMAIL_PROVIDER=smtp

# Payment provider selection is reserved for M9-T3. Production refuses fake.
# PAYMENT_PROVIDER=fake

# WhatsApp (M8-T4). "fake" is the default outside production and is refused in
# production. The token is a server secret; never store it in the database.
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=change-me
# WHATSAPP_GRAPH_VERSION=v23.0

# Phone codes use a separate random secret (at least 32 characters). Missing disables verification.
PHONE_VERIFICATION_SECRET=
